# Минимальный набор для установки через Portainer (GitHub → docker-compose.portainer.yml).
# Образы и compose всегда берутся как latest / ветка main — теги не выбираются.
#
# В Portainer: Stack → Environment variables → вставьте значения ниже (без комментариев #).

# Пароль базы данных Postgres. Придумайте длинный и сложный, никому не показывайте.
POSTGRES_PASSWORD=замените-на-сложный-пароль

# Секрет для защиты API-ключей клиентов (как «перец» при хешировании).
# Любая длинная случайная строка (от 32 символов). После смены старые ключи перестанут работать.
API_KEY_PEPPER=замените-на-длинную-случайную-строку

# Публичный адрес API в интернете (как его видят браузер и SMSC). Только https.
PUBLIC_API_URL=https://api.example.com

# Публичный адрес кабинета/админки в интернете. Только https.
PUBLIC_WEB_URL=https://app.example.com

# --- SMSC.ru: логин и пароль кабинета (или вместо них один SMSC_API_KEY) ---

# Логин в SMSC.ru
SMSC_LOGIN=

# Пароль в SMSC.ru
SMSC_PASSWORD=

# Либо API-ключ SMSC (если используете его вместо логина/пароля)
SMSC_API_KEY=

# Секрет подписи callback от SMSC (задайте свой и тот же укажите в кабинете SMSC).
# Нужен, чтобы чужие не могли подделать статусы проверок.
SMSC_CALLBACK_SECRET=замените-на-секрет-для-callback
