# Минимальный набор для Portainer (GitHub → docker-compose.portainer.yml).
# Образы и compose всегда latest / ветка main.
#
# ВАЖНО: POSTGRES_PASSWORD и API_KEY_PEPPER — это НЕ пароль входа на сайт.
# Логин в админку задаётся блоком SEED_* ниже.

# --- База и секреты приложения ---

# Пароль самой базы Postgres (внутренний). Не для входа в админку.
POSTGRES_PASSWORD=замените-на-сложный-пароль

# Секрет для защиты API-ключей клиентов. Длинная случайная строка (от 32 символов).
API_KEY_PEPPER=замените-на-длинную-случайную-строку

# Публичный HTTPS-адрес API (как в NPM). Браузер ходит сюда при логине.
PUBLIC_API_URL=https://api.example.com

# Публичный HTTPS-адрес кабинета/админки (как в NPM).
PUBLIC_WEB_URL=https://app.example.com

# --- Вход на сайт (создаётся при первом запуске / каждом migrate+seed) ---

# Email для входа в админку (/admin/login)
SEED_SUPERADMIN_EMAIL=admin@finenumbers.local

# Пароль для входа в админку. Задайте свой и используйте его на форме входа.
SEED_SUPERADMIN_PASSWORD=ChangeMeNow!

# Email кабинета клиента (/app/login), демо-организация
SEED_DEMO_ADMIN_EMAIL=demo@finenumbers.local

# Пароль кабинета клиента
SEED_DEMO_ADMIN_PASSWORD=ChangeMeNow!

# --- SMSC.ru (логин/пароль кабинета или один API-ключ) ---

SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_API_KEY=

# Секрет подписи callback от SMSC (тот же в кабинете SMSC).
SMSC_CALLBACK_SECRET=замените-на-секрет-для-callback
