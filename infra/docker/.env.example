# Docker Compose environment template.
# Copy to repo root `.env` or `infra/docker/.env` and adjust as needed.

COMPOSE_PROJECT_NAME=hlr

NODE_ENV=production

# GHCR image tag for api/worker/web (latest | sha-XXXX | semver)
IMAGE_TAG=latest

# Postgres
POSTGRES_USER=finenumbers
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finenumbers
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finenumbers:change-me@postgres:5432/finenumbers?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# App ports (host)
API_PORT=3001
WEB_PORT=3000
WORKER_CONCURRENCY=5
WORKER_METRICS_PORT=9091

PUBLIC_API_URL=https://api.example.com
PUBLIC_WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
BODY_LIMIT=256kb
BODY_LIMIT_SUBMIT=1mb
REQUEST_TIMEOUT_MS=30000
AUTH_LOGIN_RPM=20
AUTH_LOGOUT_RPM=60
RATE_LIMIT_READ_MULTIPLIER=5
RATE_LIMIT_READ_RPM_MAX=600
RATE_LIMIT_WEBHOOK_RPM=60
METRICS_ENABLED=true

# API key hashing pepper (required strong secret in production)
API_KEY_PEPPER=replace-with-long-random-secret

# SMSC (never commit real values)
SMSC_BASE_URL=https://smsc.ru
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_API_KEY=
SMSC_CALLBACK_SECRET=

# Observability (docker-compose.obs.yml)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Backups
BACKUP_KEEP_DAYS=14
