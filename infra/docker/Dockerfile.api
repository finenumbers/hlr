FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json .npmrc ./
COPY packages ./packages
COPY apps/api/package.json ./apps/api/package.json
RUN pnpm install --frozen-lockfile --filter @finenumbers/api...

FROM base AS build
COPY --from=deps /app /app
COPY . .
RUN pnpm --filter @finenumbers/db generate \
  && pnpm --filter @finenumbers/api... build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN useradd --system --uid 1001 nestjs \
  && apt-get update \
  && apt-get install -y --no-install-recommends gosu \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /data/uploads/.tmp \
  && chown -R nestjs:nestjs /data/uploads
COPY --from=build /app /app
COPY infra/docker/api-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
# Entrypoint runs as root to chown the uploads volume, then gosu → nestjs.
ENTRYPOINT ["/entrypoint.sh"]
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
