{
  "extends": "@finenumbers/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "noEmit": false,
    "incremental": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
