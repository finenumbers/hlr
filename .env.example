# Copy to .env for local development (outside Docker).
# Never commit real secrets.

NODE_ENV=development

# Apps
API_PORT=3001
WEB_PORT=3000
WORKER_CONCURRENCY=5
WORKER_METRICS_PORT=9091

# Public URLs (behind NPM in prod)
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
SESSION_TTL_HOURS=72

# Comma-separated browser origins (defaults to PUBLIC_WEB_URL)
# CORS_ORIGINS=https://app.example.com

# Behind Nginx Proxy Manager / reverse proxy
TRUST_PROXY=false

# Abuse protection (zone rate limits + payload size)
BODY_LIMIT=256kb
BODY_LIMIT_SUBMIT=1mb
BODY_LIMIT_CSV=52mb
REQUEST_TIMEOUT_CSV_MS=120000
REQUEST_TIMEOUT_MS=30000
AUTH_LOGIN_RPM=20
AUTH_LOGOUT_RPM=60
IP_RATE_LIMIT_RPM=120
# Public API zones (submit RPM comes from PlatformSettings/tenant/key)
RATE_LIMIT_READ_MULTIPLIER=5
RATE_LIMIT_READ_RPM_MAX=600
RATE_LIMIT_WEBHOOK_RPM=60
RATE_LIMIT_WEBHOOK_MULTIPLIER=1
METRICS_ENABLED=true
# OPENAPI_ENABLED=false  # disable /openapi.json outside production (ignored in production — always off)

# PostgreSQL
POSTGRES_USER=finenumbers
POSTGRES_PASSWORD=finenumbers
POSTGRES_DB=finenumbers
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finenumbers:finenumbers@localhost:5432/finenumbers?schema=public

# Seed defaults (packages/db) — only platform settings + superadmin; no demo clients
SEED_SUPERADMIN_EMAIL=admin@finenumbers.local
# Local/dev may use a short password; production/Portainer requires ≥16 and ≠ ChangeMeNow!
SEED_SUPERADMIN_PASSWORD=ChangeMeNow!
SEED_RESET_PASSWORD=false

# Redis / BullMQ
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# CSV bulk uploads (api writes, worker reads — same path/volume in prod)
UPLOAD_DIR=./data/uploads
# Orphan CSV upload TTL (hours). Parsed files are deleted immediately after csv-parse.
UPLOAD_RETENTION_HOURS=24

# API key hashing pepper (HMAC-SHA256). Required strong secret in production.
API_KEY_PEPPER=dev-only-api-key-pepper-change-me

# SMSC.ru (secrets — never expose via admin settings API)
SMSC_BASE_URL=https://smsc.ru
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_API_KEY=
SMSC_CURRENCY=RUB
SMSC_TIMEOUT_MS=15000
SMSC_RETRY_MAX=2
SMSC_RETRY_BASE_DELAY_MS=200
SMSC_CALLBACK_SECRET=

# Observability (docker-compose.obs.yml)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Backups (compose profile backup) — see docs/BACKUP_RESTORE.md
# Logical dump daily + WAL archive volume + base backup for PITR
BACKUP_KEEP_DAYS=14
