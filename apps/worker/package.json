{
  "name": "@finenumbers/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@finenumbers/billing": "workspace:*",
    "@finenumbers/config": "workspace:*",
    "@finenumbers/db": "workspace:*",
    "@finenumbers/jobs": "workspace:*",
    "@finenumbers/provider-core": "workspace:*",
    "@finenumbers/provider-smsc": "workspace:*",
    "@finenumbers/webhooks": "workspace:*",
    "bullmq": "^5.41.0",
    "ioredis": "^5.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@finenumbers/tsconfig": "workspace:*",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
